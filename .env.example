# Secretele proiectului pentru docker compose. NU se pune in git (e in .gitignore).
POSTGRES_DB=sportbuddy
POSTGRES_USER=...
POSTGRES_PASSWORD=...

# Secret JWT, minim 32 de caractere
JWT_SECRET=sportbuddy-dev-secret-schimba-in-local-minim-32-caractere

# Email Gmail (optional). Daca nu e configurat, linkurile apar doar in consola backend-ului.
# Pentru a-l activa, scoate # din liniile de mai jos si completeaza (parola de aplicatie are 16 litere).
#SPRING_MAIL_HOST=smtp.gmail.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=adresa.ta@gmail.com
#SPRING_MAIL_PASSWORD=xxxxxxxxxxxxxxxx
#APP_MAIL_FROM=SportBuddy <adresa.ta@gmail.com>

# Google Client ID (optional). Gol = butonul Google e simulat.
GOOGLE_CLIENT_ID=

# Portul API-ului pe calculatorul tau (implicit 8080). Schimba-l daca e ocupat de alt program.
#BACKEND_PORT=8081
